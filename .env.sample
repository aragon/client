# Set at build time in the existing build
ARAGON_ETH_NETWORK_TYPE=main
ARAGON_ETH_SUBSCRIPTION_EVENT_DELAY=5000
ARAGON_FORTMATIC_API_KEY=
ARAGON_PORTIS_DAPP_ID=
REACT_APP_ANALYTICS_KEY=
SUBGRAPH_API_KEY=

# Were MISSING in the existing build — fill as needed

ARAGON_DEFAULT_ETH_NODE=wss://mainnet.infura.io/ws/v3/<YOUR_INFURA_KEY>
ARAGON_ENS_REGISTRY_ADDRESS=
ARAGON_IPFS_GATEWAY=https://aragon.mypinata.cloud/ipfs
ALCHEMY_API_KEY=
#ARAGON_SELECTED_CURRENCY=
#ARAGON_PACKAGE_VERSION=
#ARAGON_CLIENT_THEME=
#ARAGON_APP_LOCATOR=
#LOCAL_CHAIN_ID=
#REACT_APP_DEPLOY_VERSION=
#REACT_APP_DEPLOY_ENVIRONMENT=
#ARAGON_MINIMUM_BALANCE=0.2
ARAGON_MINIMUM_BALANCE=0

# --- RPC nodes (src/network-config.js) ---
ARAGON_ETH_NODE_MAINNET=wss://mainnet.eth.aragon.network/ws
ARAGON_ETH_NODE_GOERLI=wss://goerli.eth.aragon.network/ws
ARAGON_ETH_NODE_OPTIMISM=wss://optimism.publicnode.com/
ARAGON_ETH_NODE_OPTIMISM_SEPOLIA=https://sepolia.optimism.io/
ARAGON_ETH_NODE_XDAI=wss://xdai.poanetwork.dev/wss
ARAGON_ETH_NODE_POLYGON=wss://mainnet-polygon.aragon.network/ws
ARAGON_ETH_NODE_POLYGON_MUMBAI=
ARAGON_ETH_NODE_BSC_TESTNET=wss://speedy-nodes-nyc.moralis.io/<MORALIS_API_KEY>/bsc/testnet/ws
ARAGON_ETH_NODE_HARMONY=wss://ws.s0.t.hmny.io/
ARAGON_ETH_NODE_HARMONY_TESTNET=wss://ws.s0.pops.one/
ARAGON_ETH_NODE_METIS=wss://andromeda-ws.metis.io/
ARAGON_ETH_NODE_METIS_TESTNET=wss://stardust-ws.metis.io/

# --- The Graph subgraph endpoints (src/network-config.js) ---
# Mainnet: if set, overrides the SUBGRAPH_API_KEY-based URL (see above)
ARAGON_GRAPH_ENDPOINT_MAINNET=
ARAGON_GRAPH_ENDPOINT_GOERLI=https://api.thegraph.com/subgraphs/name/aragon/aragon-goerli

# --- Aragon services (src/components/GlobalPreferences/Notifications/constants.js) ---
ARAGON_NOTIFICATIONS_URL=https://notifications.eth.aragon.network

# --- Analytics / monitoring (src/App.js, src/contexts/elasticAPM.js) ---
REACT_APP_RUDDERSTACK_URL=https://rudderstack.aragon.org
REACT_APP_RUDDERSTACK_CDN=https://cdn.rudderlabs.com/v1/rudder-analytics.min.js
REACT_APP_APM_SERVER_URL=https://apm-monitoring.aragon.org

